# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.wrangler/

# Local visual verification
/tmp/

# Local generated assets and Python caches
/output/
__pycache__/

# Git worktrees created by agents live inside the repo
/.claude/worktrees/

# Preserve non-regenerable work when retiring agent worktrees
/.retained/

# Private ScaleForge investor pitch authoring. The pitch stays unpublished
# until the final review passes and the owner releases it.
/docs/scaleforge-pitch/
